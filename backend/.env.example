# ── Variáveis de Ambiente — Treino.AI Backend ──────────────────────────────
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env! Ele já está no .gitignore.

# ── Banco de Dados ──────────────────────────────────────────────────────────
# PostgreSQL hospedado no Neon.tech (recomendado para produção)
# Formato: postgresql://USUARIO:SENHA@HOST.neon.tech/NOME_DB?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Se não configurar DATABASE_URL, o servidor usará SQLite local automaticamente:
# DATABASE_URL=sqlite+aiosqlite:///./treinoapp.db

# ── API de Treinos no Render ────────────────────────────────────────────────
# URL base da API externa que usa o Gemini internamente para gerar os treinos
TREINO_API_URL=https://api-treino-ygh4.onrender.com/api/v1

# Chave de autenticação da API (deixe em branco se não estiver configurada)
TREINO_API_KEY=
