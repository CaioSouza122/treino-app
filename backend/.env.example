# ── Variáveis de Ambiente — Treino.AI Backend ──────────────────────────────
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env! Ele já está no .gitignore.

# ── Banco de Dados ──────────────────────────────────────────────────────────
# PostgreSQL hospedado no Neon.tech (recomendado para produção)
# Formato: postgresql://USUARIO:SENHA@HOST.neon.tech/NOME_DB?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Se não configurar DATABASE_URL, o servidor usará SQLite local automaticamente:
# DATABASE_URL=sqlite+aiosqlite:///./treinoapp.db

# ── Coach IA ────────────────────────────────────────────────────────────────
# Chave do Google Gemini (https://aistudio.google.com/). Sem ela o chat responde
# "Estou sobrecarregado agora".
GEMINI_API_KEY=

# Opcional: modelos tentados em ordem, separados por vírgula.
# GEMINI_MODELOS=gemini-2.5-flash,gemini-3.5-flash-lite

# ── CORS ────────────────────────────────────────────────────────────────────
# Origens do app web, separadas por vírgula (o app nativo não usa CORS).
# Em produção: a URL do front no Render, ex: https://hipertrofia.onrender.com
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# ── Login ───────────────────────────────────────────────────────────────────
# Segredo que assina os tokens de sessão (JWT). Obrigatório em produção; trocar
# o valor desloga todo mundo. Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sem ele (só em desenvolvimento) o backend usa um segredo temporário por execução.
JWT_SECRET=
