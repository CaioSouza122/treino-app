# ── Variáveis de Ambiente — HIPERTROF.IA Mobile ────────────────────────────
# Copie este arquivo para .env e preencha com seus valores.
# Variáveis com prefixo EXPO_PUBLIC_ são expostas ao código do app.
# NUNCA commite o arquivo .env!

# ── API do Backend ──────────────────────────────────────────────────────────
# URL base do backend FastAPI. Em desenvolvimento local, use o IP da sua máquina
# (não use 'localhost' — o celular físico não consegue resolver localhost).
# Exemplo para emulador Android: http://10.0.2.2:8000
# Exemplo para celular físico:   http://192.168.1.x:8000
# Exemplo para produção:         https://sua-api.onrender.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Identificação do Usuário ────────────────────────────────────────────────
# ID único do usuário para associar treinos ao histórico.
# Em produção, isso será substituído pelo ID do usuário autenticado.
EXPO_PUBLIC_TREINO_USER_ID=mobile-dev-user

# ── OAuth (opcional) ────────────────────────────────────────────────────────
# Necessário apenas se estiver usando o fluxo de login com OAuth.
# EXPO_PUBLIC_OAUTH_PORTAL_URL=
# EXPO_PUBLIC_OAUTH_SERVER_URL=
# EXPO_PUBLIC_APP_ID=
# EXPO_PUBLIC_OWNER_OPEN_ID=
# EXPO_PUBLIC_OWNER_NAME=
